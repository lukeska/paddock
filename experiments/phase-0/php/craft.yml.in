php-version: "@PHP_VERSION@"

extensions:
  - bcmath
  - bz2
  - calendar
  - ctype
  - curl
  - dom
  - exif
  - fileinfo
  - filter
  - gd
  - gmp
  - iconv
  - intl
  - mbstring
  - mysqli
  - opcache
  - openssl
  - pcntl
  - pdo
  - pdo_mysql
  - pdo_pgsql
  - pdo_sqlite
  - pgsql
  - phar
  - posix
  - redis
  - session
  - simplexml
  - soap
  - sockets
  - sodium
  - sqlite3
  - tokenizer
  - xml
  - xmlreader
  - xmlwriter
  - xsl
  - zip
  - zlib

sapi:
  - cli
  - fpm
