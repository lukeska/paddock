[Unit]
Description=Paddock lifecycle PHP @VERSION@
PartOf=paddock-lifecycle.target
After=network-online.target
StartLimitIntervalSec=10s
StartLimitBurst=3

[Service]
Type=simple
User=@USER@
Group=@GROUP@
ExecStart=@RUNTIME_COMMAND@ @RUNTIME_ROOT@ php-fpm -d opcache.lockfile_path=@STATE_DIR@ --nodaemonize --fpm-config @FPM_CONFIG@
ExecStartPost=/run/paddock-lifecycle-wait-socket @SOCKET@
Restart=on-failure
RestartSec=500ms
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@
