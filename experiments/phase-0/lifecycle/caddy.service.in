[Unit]
Description=Paddock lifecycle Caddy
PartOf=paddock-lifecycle.target
Wants=paddock-lifecycle-php84.service paddock-lifecycle-php85.service
After=paddock-lifecycle-php84.service paddock-lifecycle-php85.service
StartLimitIntervalSec=10s
StartLimitBurst=3

[Service]
Type=notify
User=@USER@
Group=@GROUP@
Environment=XDG_DATA_HOME=@STATE_DIR@/data
Environment=XDG_CONFIG_HOME=@STATE_DIR@/config
ExecStartPre=/usr/bin/caddy validate --config @CADDY_CONFIG@ --adapter caddyfile
ExecStart=/usr/bin/caddy run --config @CADDY_CONFIG@ --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config @CADDY_CONFIG@ --adapter caddyfile --address 127.0.0.1:@ADMIN_PORT@
Restart=on-failure
RestartSec=500ms
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@
