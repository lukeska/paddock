#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import pwd
import shutil
import subprocess
import sys


OWNED = (
    "/etc/paddock/dnsmasq.conf",
    "/etc/paddock/integration.json",
    "/etc/paddock/rootCA.pem",
    "/etc/systemd/system/paddock.target",
    "/etc/systemd/system/paddock-dns.service",
    "/etc/systemd/system/paddock-dns-route.service",
    "/etc/systemd/system/paddock-caddy.service",
    "/etc/systemd/system/paddock-php@.service",
    "/etc/polkit-1/rules.d/49-paddock.rules",
)

INSTALLATION = Path("/etc/paddock/integration.json")
SYSTEM_CA = Path("/etc/paddock/rootCA.pem")

# Must stay equal to paddock.paths.SYSTEM_RUNTIME_ROOT.
RUNTIME_ROOT = "paddock"

# Bump whenever php_unit() changes. The generated unit carries this as an
# `X-` key, which systemd ignores, and the package post_upgrade scriptlet
# compares it against the installed unit. Without it an upgrade that changes
# the template leaves the old unit in place and only breaks at the next boot,
# because the unit is written during integration and is not owned by pacman.
# A test pins the template digest to this number so it cannot drift.
UNIT_VERSION = 2


def php_unit(user: str, group: int, home: Path, data: Path, state: Path) -> str:
    """Render the templated PHP-FPM unit.

    systemd owns the runtime directory. `RuntimeDirectory=` creates
    `/run/paddock/php/<minor>` with the unit's own user and mode before the
    mount namespace is built, and removes it on stop without touching a
    sibling version's socket. Naming a not-yet-existing `/run` path in
    `ReadWritePaths=` instead aborts startup with 226/NAMESPACE, and a
    `/run/user/<uid>` path additionally ties a system unit to a login session
    that does not exist at boot and disappears on logout without linger.

    php-fpm is Type=simple, so the unit counts as started before the master
    listens. `ExecStartPost=` blocks on the socket and `Before=` orders Caddy
    after that gate, which is the readiness edge ADR 0005 specifies. The
    ordering carries no requirement, so a later FPM failure yields a 502 for
    that version only instead of taking Caddy down.

    The home directory is writable because PHP applications write inside their
    own project: Laravel needs `storage/` and `bootstrap/cache/`, and a
    read-only project turns every such write into a 500. `ProtectHome=read-only`
    made `tempnam(dirname($path), ...)` fall back to the private /tmp and emit
    `file created in the system's temporary directory`, which Laravel promotes
    to an ErrorException. Granting each linked root individually would instead
    require root on every `paddock link`, so the writable unit is the whole
    home minus explicit denials. `ProtectSystem=strict` still keeps /usr and
    /etc read-only, and `InaccessiblePaths=` hides the user secrets a
    compromised application would want most, including Paddock's own CA key.
    Enumerated denials are not a complete boundary; php-fpm runs as the desktop
    user, so DAC remains the real limit.
    """
    return (
        f"""[Unit]\nDescription=Paddock PHP %i\nPartOf=paddock.target\n"""
        f"""X-Paddock-Unit-Version={UNIT_VERSION}\n"""
        f"""Before=paddock-caddy.service\n"""
        f"""StartLimitIntervalSec=10s\nStartLimitBurst=3\n"""
        f"""ConditionFileIsExecutable={data}/runtimes/active/%i/bin/php-fpm\n"""
        f"""ConditionPathExists={state}/fpm/php-%i.conf\n"""
        f"""[Service]\nUser={user}\nGroup={group}\n"""
        f"""Environment=PHPRC={data}/runtimes/active/%i/etc/php.ini\n"""
        f"""Environment=PHP_INI_SCAN_DIR={data}/runtimes/active/%i/etc/conf.d\n"""
        f"""RuntimeDirectory={RUNTIME_ROOT}/php/%i\nRuntimeDirectoryMode=0700\n"""
        f"""ExecStart=/usr/lib/paddock/php-fpm-launcher {data}/runtimes/active/%i {state}/fpm/php-%i.conf\n"""
        f"""ExecStartPost=/usr/lib/paddock/wait-for-socket /run/{RUNTIME_ROOT}/php/%i/fpm.sock\n"""
        f"""Restart=on-failure\nRestartSec=500ms\n"""
        f"""NoNewPrivileges=yes\nPrivateDevices=yes\nPrivateTmp=yes\n"""
        f"""ProtectSystem=strict\nProtectHome=no\n"""
        f"""ReadWritePaths={home} {state}\n"""
        f"""InaccessiblePaths=-{home}/.ssh -{home}/.gnupg -{data}/pki\n"""
    )


def run(command: list[str], *, user: str | None = None, check: bool = True) -> None:
    if user:
        command = ["runuser", "--user", user, "--", *command]
    subprocess.run(command, check=check)


def write(path: str, value: str, mode: int = 0o644) -> None:
    destination = Path(path)
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(f".{destination.name}.paddock-new")
    temporary.write_text(value, encoding="utf-8")
    temporary.chmod(mode)
    os.replace(temporary, destination)


def directories(user: str, data_value: str, state_value: str) -> tuple[pwd.struct_passwd, Path, Path]:
    account = pwd.getpwnam(user)
    if account.pw_uid == 0:
        raise SystemExit("refusing to configure root as the desktop user")
    data = Path(data_value)
    state = Path(state_value)
    for label, path in (("data", data), ("state", state)):
        if not path.is_absolute() or not path.is_dir() or path.stat().st_uid != account.pw_uid:
            raise SystemExit(f"{label} directory must be absolute, existing, and owned by {user}: {path}")
    return account, data, state


def install(user: str, data_value: str, state_value: str) -> None:
    account, data, state = directories(user, data_value, state_value)
    home = Path(account.pw_dir)
    ca = data / "pki/rootCA.pem"
    if not ca.is_file():
        raise SystemExit(f"public CA does not exist: {ca}")
    for path in OWNED:
        if Path(path).exists():
            raise SystemExit(f"refusing to replace existing path: {path}")
    existing_connections = subprocess.run(
        ["nmcli", "-t", "-f", "NAME", "connection", "show"],
        check=True, text=True, capture_output=True,
    ).stdout.splitlines()
    if "paddock-dns" in existing_connections:
        raise SystemExit("refusing to replace existing NetworkManager connection: paddock-dns")

    write("/etc/paddock/dnsmasq.conf", "port=53\nlisten-address=127.0.0.1\nbind-interfaces\nno-hosts\nno-resolv\ndomain-needed\nlocal=/test/\naddress=/.test/127.0.0.1\n")
    write("/etc/systemd/system/paddock.target", """[Unit]\nDescription=Paddock local development stack\nWants=paddock-dns.service paddock-dns-route.service paddock-caddy.service paddock-php@8.4.service paddock-php@8.5.service\nAfter=network-online.target\n[Install]\nWantedBy=multi-user.target\n""")
    write("/etc/systemd/system/paddock-dns.service", """[Unit]\nDescription=Paddock .test DNS\nPartOf=paddock.target\n[Service]\nExecStart=/usr/bin/dnsmasq --no-daemon --conf-file=/etc/paddock/dnsmasq.conf\nRestart=on-failure\nNoNewPrivileges=yes\nPrivateDevices=yes\nProtectSystem=strict\nProtectHome=yes\n""")
    write("/etc/systemd/system/paddock-dns-route.service", """[Unit]\nDescription=Paddock route-only DNS\nPartOf=paddock.target\nRequires=paddock-dns.service NetworkManager.service\nAfter=paddock-dns.service NetworkManager.service systemd-resolved.service\n[Service]\nType=oneshot\nExecStart=/usr/bin/nmcli connection up paddock-dns\nRemainAfterExit=yes\n""")
    write("/etc/systemd/system/paddock-caddy.service", f"""[Unit]\nDescription=Paddock Caddy\nPartOf=paddock.target\nAfter=paddock-dns-route.service\n[Service]\nType=notify\nUser={user}\nGroup={account.pw_gid}\nEnvironment=XDG_DATA_HOME={state}/caddy-data\nEnvironment=XDG_CONFIG_HOME={state}/caddy-config\nExecStartPre=+/usr/lib/paddock/check-ports\nExecStartPre=/usr/bin/caddy validate --config={state}/caddy/Caddyfile --adapter=caddyfile\nExecStart=/usr/bin/caddy run --config={state}/caddy/Caddyfile --adapter=caddyfile\nExecReload=/usr/bin/caddy reload --config={state}/caddy/Caddyfile --adapter=caddyfile --address=127.0.0.1:20195\nRestart=on-failure\nAmbientCapabilities=CAP_NET_BIND_SERVICE\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\nNoNewPrivileges=yes\nPrivateDevices=yes\nProtectSystem=strict\nProtectHome=read-only\nReadWritePaths={state} {data}\n""")
    write("/etc/systemd/system/paddock-php@.service", php_unit(user, account.pw_gid, home, data, state))
    allowed = json.dumps(user)
    write("/etc/polkit-1/rules.d/49-paddock.rules", f"""polkit.addRule(function(action, subject) {{\n  var unit = action.lookup('unit') || '';\n  if (action.id == 'org.freedesktop.systemd1.manage-units' && subject.user == {allowed} && (unit == 'paddock.target' || unit.indexOf('paddock-') == 0)) return polkit.Result.YES;\n}});\n""")
    shutil.copyfile(ca, SYSTEM_CA)
    SYSTEM_CA.chmod(0o644)
    write(
        str(INSTALLATION),
        json.dumps(
            {
                "version": 1,
                "user": user,
                "data_dir": str(data),
                "state_dir": str(state),
            },
            sort_keys=True,
        ) + "\n",
        0o600,
    )
    run(["nmcli", "connection", "add", "type", "dummy", "ifname", "paddock0", "con-name", "paddock-dns", "ipv4.method", "manual", "ipv4.addresses", "192.0.2.10/32", "ipv4.dns", "127.0.0.1", "ipv4.dns-search", "~test", "ipv4.never-default", "yes", "ipv6.method", "disabled", "connection.autoconnect", "yes"])
    nss = home / ".pki/nssdb"
    nss.mkdir(parents=True, exist_ok=True)
    shutil.chown(nss.parent, user=user)
    if not (nss / "cert9.db").exists():
        run(["certutil", "-N", "--empty-password", "-d", f"sql:{nss}"], user=user)
    run(["trust", "anchor", str(SYSTEM_CA)])
    run(["certutil", "-A", "-d", f"sql:{nss}", "-n", "Paddock Local CA", "-t", "C,,", "-i", str(ca)], user=user)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", "paddock.target"])


def uninstall(user: str, data_value: str, state_value: str) -> None:
    account = pwd.getpwnam(user)
    data = Path(data_value)
    home = Path(account.pw_dir)
    ca = SYSTEM_CA if SYSTEM_CA.is_file() else data / "pki/rootCA.pem"
    run(["systemctl", "disable", "--now", "paddock.target"], check=False)
    run(["nmcli", "connection", "delete", "paddock-dns"], check=False)
    run(["trust", "anchor", "--remove", str(ca)], check=False)
    run(["certutil", "-D", "-d", f"sql:{home / '.pki/nssdb'}", "-n", "Paddock Local CA"], user=user, check=False)
    for path in OWNED:
        Path(path).unlink(missing_ok=True)
    run(["systemctl", "daemon-reload"])


def package_remove() -> None:
    """Remove machine integration without deleting any user-owned state."""
    if INSTALLATION.is_file():
        try:
            record = json.loads(INSTALLATION.read_text(encoding="utf-8"))
            if record.get("version") != 1:
                raise ValueError("unsupported installation record")
            uninstall(record["user"], record["data_dir"], record["state_dir"])
            return
        except (KeyError, OSError, TypeError, ValueError) as error:
            print(f"warning: invalid Paddock installation record: {error}", file=sys.stderr)

    # Older packages have no installation record. Still remove every resource
    # whose global name is exclusively reserved for Paddock.
    run(["systemctl", "disable", "--now", "paddock.target"], check=False)
    run(["nmcli", "connection", "delete", "paddock-dns"], check=False)
    if SYSTEM_CA.is_file():
        run(["trust", "anchor", "--remove", str(SYSTEM_CA)], check=False)
    for path in OWNED:
        Path(path).unlink(missing_ok=True)
    run(["systemctl", "daemon-reload"])


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "action", choices=("install", "uninstall", "package-remove", "unit-version")
    )
    parser.add_argument("--user")
    parser.add_argument("--data-dir")
    parser.add_argument("--state-dir")
    args = parser.parse_args()
    if args.action == "unit-version":
        print(UNIT_VERSION)
        return 0
    if os.geteuid() != 0:
        raise SystemExit("system-helper must run as root")
    if args.action == "package-remove":
        package_remove()
    elif not all((args.user, args.data_dir, args.state_dir)):
        parser.error("install and uninstall require --user, --data-dir, and --state-dir")
    elif args.action == "install":
        try:
            install(args.user, args.data_dir, args.state_dir)
        except Exception:
            uninstall(args.user, args.data_dir, args.state_dir)
            raise
    else:
        uninstall(args.user, args.data_dir, args.state_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
