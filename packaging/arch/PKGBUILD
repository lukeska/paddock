pkgname=paddock
pkgver=0.1.0
pkgrel=13
pkgdesc='Local Laravel development environment for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/lukeska/paddock'
license=('MIT')
depends=('python' 'caddy' 'dnsmasq' 'mkcert' 'nss' 'p11-kit' 'networkmanager' 'polkit'
         'podman')
install=paddock.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('67aff1809c20a70d8b9b9143d5f344df43339ba96b52f578b8d905e43f3c7085')

check() {
  cd "$srcdir/$pkgname-$pkgver"
  PYTHONPATH=src python -m unittest discover -s tests -v
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local site_packages
  site_packages=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib", vars={"base":"/usr", "platbase":"/usr"}))')
  install -d "$pkgdir$site_packages"
  cp -r --no-preserve=ownership src/paddock "$pkgdir$site_packages/paddock"
  find "$pkgdir$site_packages/paddock" -type d -name __pycache__ -prune -exec rm -rf -- {} +
  install -Dm755 packaging/arch/paddock "$pkgdir/usr/bin/paddock"
  install -Dm755 system/system-helper "$pkgdir/usr/lib/paddock/system-helper"
  install -Dm755 system/php-fpm-launcher "$pkgdir/usr/lib/paddock/php-fpm-launcher"
  install -Dm755 system/check-ports "$pkgdir/usr/lib/paddock/check-ports"
  install -Dm755 system/wait-for-socket "$pkgdir/usr/lib/paddock/wait-for-socket"
  install -Dm644 resources/artifacts.json "$pkgdir/usr/share/paddock/artifacts.json"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/state-schema-v1.md "$pkgdir/usr/share/doc/$pkgname/state-schema-v1.md"
}
